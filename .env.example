# Reference only: configure these in Vercel's environment-variable settings.
# Local Python startup reads exported variables; it does not load .env files.
# Keep real secrets out of Git. These blank values are not deployable credentials.

# Required on Vercel. Use the provider's pooled PostgreSQL URL with TLS parameters.
# Example format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Leave unset/blank locally to keep using outputs/review.db (SQLite).
DATABASE_URL=

# Required on Vercel: stable random value, at least 32 characters.
# Generate locally: python3 -c 'import secrets; print(secrets.token_hex(32))'
COMPREHENSIVE_SECRET_KEY=

# Explicitly opt in to PUBLIC fictional demo credentials and records on Vercel.
# Idempotent; 0 prevents future seeding but does not delete existing records.
COMPREHENSIVE_SEED_DEMO=1

# Deployment-compatible modes; the Claude CLI is available only for local use.
COMPREHENSIVE_USAGE_MODEL=rules
COMPREHENSIVE_DOCUMENT_SUMMARY_MODEL=structured
